# Generated output — never committed, always rebuilt.
_site/
.quarto/
*_files/

# Quarto execution cache
/.quarto/
_freeze/

# Environments
# pixi is the project standard; the rest catch hand-rolled envs.
.pixi/
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Tooling caches that contain account identifiers or local state.
# .wrangler/cache/wrangler-account.json holds the Cloudflare account ID.
.wrangler/
.nextflow/
.nextflow.log*

# Working notes for Claude Code sessions. Deliberately NOT committed: this
# repository is public, and these files record status candidly (see the
# publishing constraint in CLAUDE.md). CLAUDE.md itself is committed.
NEXT.md
docs/sessions/

# Instructor drop zone. IGNORED, and this is the one difference from the
# course repository that matters most.
#
# There, incoming/ is committed and stays as the record of what was handed
# over -- safe, because that repository is private. Here the repository is
# PUBLIC, so committing a dropped slide deck would publish it, along with
# whatever third-party figures it contains and whatever licence they carry.
# Drops are a working area only; what survives is the material written from
# them, with provenance established at the point of use.
#
# The README is committed so the directory documents itself.
instructor/incoming/*
!instructor/incoming/README.md

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

**/*.quarto_ipynb
